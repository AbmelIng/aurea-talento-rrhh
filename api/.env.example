# Copiar estos valores al entorno del proceso; la API no carga este archivo.
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:4201
APP_SECRET=genere-una-clave-aleatoria-estable-de-al-menos-32-caracteres
# Para crear el primer administrador una sola vez:
BOOTSTRAP_EMAIL=administrador@suempresa.com
BOOTSTRAP_FIRST_NAME=Nombre
BOOTSTRAP_LAST_NAME=Apellido
# SQLite predeterminado; para MySQL definir también:
# DB_DRIVER=mysql
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=aurea
# MYSQL_PASSWORD=elija-una-clave-privada
# MYSQL_DATABASE=aurea_talento
